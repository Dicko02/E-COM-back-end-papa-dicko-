# ============================================================
# WAYNE ENTERPRIZE — Configuration Back-end
# Copie ce fichier en .env et remplis les vraies valeurs
# NE JAMAIS committer le fichier .env sur GitHub
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # Mettre "production" en déploiement

# ── Base de données ───────────────────────────────────────────
# Local (développement)
MONGO_URI=mongodb://localhost:27017/wayne-enterprize
# Cloud (production — MongoDB Atlas)
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/wayne-enterprize

# ── JWT ───────────────────────────────────────────────────────
# Minimum 32 caractères, générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING

# ── Email (Gmail SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # Mot de passe d'application Gmail (pas le mot de passe normal)
SMTP_FROM=noreply@wayneenterpize.com
SMTP_FROM_NAME=Wayne Enterprize

# ── CORS ─────────────────────────────────────────────────────
# URL du front-end en production (Vercel)
ORIGIN=https://wayne-enterprize.vercel.app

# ── Images ───────────────────────────────────────────────────
IMAGE_MAX_WIDTH=350
IMAGE_MAX_HEIGHT=350
IMAGE_QUALITY=85
