# ============================================================
# WAYNE ENTERPRIZE — Configuration Back-end
# ============================================================
# CE FICHIER EST UNE DOCUMENTATION — pas utilisé en production.
# Les vraies valeurs sont configurées dans le dashboard Render :
#   ton service > Environment
#
# Si une valeur change, mettre à jour UNIQUEMENT dans Render.
# Jamais besoin de modifier le code source.
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
PORT=10000
NODE_ENV=production

# ── Base de données ───────────────────────────────────────────
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.0k1yfbh.mongodb.net/wayne-enterprize

# ── JWT ───────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING

# ── CORS ─────────────────────────────────────────────────────
# URL du front-end Vercel
ORIGIN=https://e-com-front-end2.vercel.app

# ── Email (Gmail SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=noreply@wayneenterpize.com
SMTP_FROM_NAME=Wayne Enterprize
